---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import DoorStrip from '../../../components/DoorStrip.astro';
import RouteDiagram from '../../../components/RouteDiagram.astro';
import Source from '../../../components/Source.astro';
import Check from '../../../components/Check.astro';
import NextStation from '../../../components/NextStation.astro';
import { stationCode } from '../../../lib/content';
import { inkOn, loadProjects, type Chapter, type Project } from '../../../lib/journal';

export async function getStaticPaths() {
  const projects = await loadProjects();
  return projects.flatMap((project) =>
    project.chapters.map((chapter, i) => ({
      params: { project: project.slug, chapter: chapter.slug },
      props: { project, chapter, next: project.chapters[i + 1] },
    })),
  );
}

const { project, chapter, next } = Astro.props as { project: Project; chapter: Chapter; next?: Chapter };
const { data } = project;
const { Content } = await render(chapter);
const terms = Object.fromEntries((await getCollection('glossary')).map((t) => [t.id, t.data]));
const stops = project.chapters.map((c) => ({ station: c.data.station, title: c.data.title, slug: c.slug }));
const code = stationCode(data.code, chapter.data.station);
const evidenceText = {
  witnessed: '',
  reconstructed: 'This chapter is rebuilt from the record (the design spec, plan and git commits of a session whose conversation was not kept). Nothing here is invented, but some of the reasons are summarised from those documents.',
  mixed: 'Parts of this chapter come from our conversation and parts are rebuilt from the record (specs, plans and git commits).',
} as const;
---
<Base title={`${code} ${chapter.data.title}`} description={chapter.data.summary} calm>
  <div class="wrap">
    <DoorStrip slug={project.slug} code={data.code} color={data.color} ink={data.ink} title={data.title} stops={stops} current={chapter.data.station} />
  </div>

  <article class="wrap chapter" style={`--line:${data.color}`} data-project={project.slug} data-station={chapter.data.station}>
    <header class="chapter__head">
      <h1 class="has-pill"><span class="pill" style={`background:${data.color};color:${inkOn(data.ink)}`}>{code}</span><span>{chapter.data.title}</span></h1>
      <p class="chapter__summary">{chapter.data.summary}</p>
      <p class="chapter__meta">{chapter.data.minutes} min read</p>
      {chapter.data.evidence && evidenceText[chapter.data.evidence] && (
        <p class="chapter__evidence"><strong>Where this comes from.</strong> {evidenceText[chapter.data.evidence]}</p>
      )}
    </header>

    <div class="prose">
      <Content components={{ RouteDiagram, Source }} />
    </div>

    {chapter.data.sources.length > 0 && (
      <section class="sources" aria-labelledby="sources-title">
        <h2 id="sources-title">See the real thing</h2>
        <ul>
          {chapter.data.sources.map((s) => <li><Source href={s.url} label={s.label} /></li>)}
        </ul>
      </section>
    )}

    <Check items={chapter.data.check} />
    <NextStation slug={project.slug} code={data.code} color={data.color} ink={data.ink} next={next && { station: next.data.station, title: next.data.title, slug: next.slug }} />
  </article>

  <script type="application/json" id="glossary-data" set:html={JSON.stringify(terms)} />
</Base>

<script>
  import '../../../scripts/terms';
  import { savePosition } from '../../../scripts/position';
  const article = document.querySelector<HTMLElement>('[data-project]');
  if (article) savePosition(article.dataset.project!, Number(article.dataset.station));
</script>

<style>
  .chapter { padding-block: var(--s-7) var(--s-8); }
  .chapter__head, .prose, .sources, .chapter :global(.check), .chapter :global(.next) { max-width: var(--measure); }
  .chapter__head { display: grid; gap: var(--s-3); margin-bottom: var(--s-7); }
  .chapter__summary { font-size: var(--step-1); line-height: 1.5; color: var(--ink-soft); }
  .chapter__meta { font-family: var(--font-sign); font-weight: 650; color: var(--ink-soft); }
  .chapter__evidence { padding: var(--s-3) var(--s-4); border: 2px dashed var(--track); border-radius: 10px; font-size: var(--step--1); }

  .prose { display: flow-root; }
  .prose :global(> * + *) { margin-top: var(--s-4); }
  .prose :global(h2) { margin-top: var(--s-7); font-size: var(--step-2); }
  .prose :global(h3) { margin-top: var(--s-6); }
  .prose :global(h2 + *), .prose :global(h3 + *) { margin-top: var(--s-3); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4rem; }
  .prose :global(li + li) { margin-top: var(--s-2); }
  .prose :global(li::marker) { color: var(--ink-soft); }
  .prose :global(strong) { font-weight: 750; }
  .prose :global(blockquote) { margin-inline: 0; padding-left: var(--s-4); border-left: 1px solid var(--rule); color: var(--ink-soft); font-style: italic; }
  .prose :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: var(--step--1); }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: var(--s-2) var(--s-3); border-bottom: 1px solid var(--rule); }
  .prose :global(th) { font-family: var(--font-sign); font-weight: 750; border-bottom-color: var(--ink); }
  .prose :global(hr) { border: 0; height: var(--line-width); background: var(--line); border-radius: 3px; margin-block: var(--s-7); width: 4rem; }

  .sources { margin-top: var(--s-7); }
  .sources h2 { font-size: var(--step-2); margin-bottom: var(--s-3); }
  .sources ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-3); }
</style>
