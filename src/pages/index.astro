---
import Base from '../layouts/Base.astro';
import NetworkLine from '../components/NetworkLine.astro';
import { formatDate, inkOn, loadProjects } from '../lib/journal';

const projects = await loadProjects();
---
<Base title="Project Journal" description="How each of my coding projects was built, explained from the ground up, one station at a time.">
  <section class="wrap intro">
    <h1>Project Journal</h1>
    <p>How each of my projects was built, explained from the ground up. Every project is a line and every chapter a station.</p>
  </section>

  <section class="wrap network" aria-label="Network map">
    {projects.map((p) => (
      <article class="project">
        <NetworkLine project={p} />
        <div class="project__meta">
          <h2>
            <a href={`/projects/${p.slug}`}>
              <span class="project__code" style={`background:${p.data.color};color:${inkOn(p.data.ink)}`}>{p.data.code}</span>
              {p.data.title}
            </a>
          </h2>
          <p class="project__summary">{p.data.summary}</p>
          <p class="project__facts">{p.chapters.length} {p.chapters.length === 1 ? 'station' : 'stations'}, {formatDate(p.data.startedAt)} to {formatDate(p.data.endedAt)}</p>
          <p class="project__go">
            {p.chapters.length > 0 && <a class="go" href={`/projects/${p.slug}/${p.chapters[0].slug}`} data-continue={p.slug}>Start at {p.data.code}01</a>}
            <a class="go go--quiet" href={`/projects/${p.slug}/timeline`}>Timeline</a>
          </p>
        </div>
      </article>
    ))}
  </section>
</Base>

<script>
  import { readPosition } from '../scripts/position';
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-continue]')) {
    const slug = link.dataset.continue!;
    const station = readPosition(slug);
    if (!station) continue;
    const stop = document.querySelector<HTMLElement>(`[data-line="${slug}"] [data-station="${station}"]`);
    stop?.classList.add('is-here');
    stop?.querySelector('a')?.insertAdjacentHTML('beforeend', '<span class="visually-hidden"> (you are here)</span>');
    const href = stop?.querySelector('a')?.getAttribute('href');
    const code = stop?.querySelector('.net__code')?.textContent;
    if (href && code) {
      link.href = href;
      link.textContent = `Continue at ${code}`;
    }
  }
</script>

<style>
  .intro { padding-block: var(--s-6) 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2) var(--s-5); }
  .intro h1 { font-size: var(--step-3); }
  .intro p { max-width: 48ch; font-size: var(--step-0); line-height: 1.5; color: var(--ink-soft); }
  .network { display: grid; gap: var(--s-8); padding-bottom: var(--s-8); }
  .project { display: grid; gap: var(--s-5); }
  .project__meta { display: grid; gap: var(--s-3); max-width: 62ch; padding-left: 3.25rem; }
  h2 { font-size: var(--step-3); }
  h2 a { text-decoration: none; display: inline-flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
  h2 a:hover { text-decoration: underline; }
  .project__code { font-size: var(--step-0); padding: 0.3em 0.6em 0.2em; border-radius: var(--radius-pill); }
  .project__summary { font-size: var(--step-1); line-height: 1.5; }
  .project__facts { color: var(--ink-soft); font-family: var(--font-sign); font-weight: 650; }
  .project__go { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
  .go {
    display: inline-flex; align-items: center; min-height: 48px;
    padding: 0 var(--s-5);
    border-radius: var(--radius-pill);
    background: var(--ink); color: var(--ground);
    font-family: var(--font-sign); font-weight: 750;
    text-decoration: none;
    transition: transform 0.15s var(--ease-out);
  }
  .go:active { transform: scale(0.98); }
  .go--quiet { background: none; color: var(--ink); box-shadow: inset 0 0 0 2px var(--ink); }
  .go:hover { text-decoration: underline; }
  @media (max-width: 52rem) { .project__meta { padding-left: 0; } .project { gap: var(--s-4); } .network { gap: var(--s-7); } }
</style>
