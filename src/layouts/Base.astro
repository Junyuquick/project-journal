---
import { url, pagePath } from '../lib/url';
import '../styles/base.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  /** quieter sky for reading pages: fewer moths, dimmer lights */
  calm?: boolean;
}
const { title, description, calm = false } = Astro.props;
const fullTitle = title === 'Project Journal' ? title : `${title} | Project Journal`;
const path = pagePath(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('pj-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body data-calm={calm || undefined}>
    <div class="sky" aria-hidden="true">
      <div class="aurora aurora--a"></div>
      <div class="aurora aurora--b"></div>
      <div class="moon"></div>
    </div>
    <canvas id="sky" aria-hidden="true"></canvas>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap site-head__row">
        <a class="wordmark" href={url('/')} aria-current={path === '/' ? 'page' : undefined}>Project Journal</a>
        <nav aria-label="Site">
          <a href={url('/')} aria-current={path === '/' ? 'page' : undefined}>Journals</a>
          <a href={url('/glossary')} aria-current={path.startsWith('/glossary') ? 'page' : undefined}>Firefly jar</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      import '../scripts/sky';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -3rem;
    background: var(--flow-accent);
    color: var(--on-accent);
    padding: var(--s-2) var(--s-4);
    border-radius: var(--radius-pill);
    z-index: 10;
  }
  .skip:focus { top: var(--s-2); }

  /* The sky: fixed behind everything. The aurora and moon move on the compositor, the canvas paints the rest. */
  .sky { position: fixed; inset: 0; z-index: -2; pointer-events: none; overflow: hidden; background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 55%, var(--sky-low) 100%); }
  #sky { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  body[data-calm] #sky { opacity: 0.8; }
  .aurora { position: absolute; width: 90vmax; height: 90vmax; border-radius: 50%; will-change: transform; }
  .aurora--a { left: -35vmax; top: -45vmax; background: radial-gradient(closest-side, var(--aurora-a), transparent); animation: drift-a 70s ease-in-out infinite alternate; }
  .aurora--b { right: -40vmax; bottom: -50vmax; background: radial-gradient(closest-side, var(--aurora-b), transparent); animation: drift-b 90s ease-in-out infinite alternate; }
  @keyframes drift-a { to { transform: translate3d(28vmax, 18vmax, 0) scale(1.15); } }
  @keyframes drift-b { to { transform: translate3d(-30vmax, -14vmax, 0) scale(1.2); } }
  .moon {
    position: absolute;
    right: clamp(1.5rem, 8vw, 7rem);
    top: clamp(4.5rem, 12vh, 8rem);
    width: clamp(3.5rem, 7vw, 6.5rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 38%, var(--moon-a), var(--moon-b) 70%);
    box-shadow: 0 0 60px 26px rgb(var(--moon-halo) / 0.22), 0 0 170px 80px rgb(190 170 255 / 0.14);
    animation: moon-breathe 12s ease-in-out infinite alternate;
  }
  /* on reading pages the moon sinks below the star trail and dims */
  body[data-calm] .moon { top: 11rem; opacity: 0.5; }
  @media (max-width: 40rem) { body[data-calm] .moon { top: 14rem; opacity: 0.3; } }
  @keyframes moon-breathe { to { transform: translateY(10px) scale(1.04); } }

  .site-head { position: relative; }
  .site-head__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 4.5rem;
  }
  .wordmark {
    font-family: var(--font-sign);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-sign);
    font-weight: 600;
  }
  nav a {
    text-decoration: none;
    padding: var(--s-2) var(--s-3);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  @media (hover: hover) and (pointer: fine) { nav a:hover { background: var(--glass); } }
  nav a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--flow-accent); border-radius: 0; }
  @media (max-width: 30rem) {
    .wordmark { font-size: var(--step-0); }
    nav { gap: 0; }
    nav a { padding-inline: var(--s-2); }
    nav :global([data-theme-label]) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
  @media (prefers-reduced-motion: reduce) { .aurora, .moon { animation: none; } }
</style>
