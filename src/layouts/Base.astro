---
import { url, pagePath } from '../lib/url';
import '../styles/base.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  /** quieter background for reading pages */
  calm?: boolean;
}
const { title, description, calm = false } = Astro.props;
const fullTitle = title === 'Project Journal' ? title : `${title} | Project Journal`;
const path = pagePath(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('pj-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body data-calm={calm || undefined}>
    <canvas id="flow-field" aria-hidden="true"></canvas>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap site-head__row">
        <a class="wordmark" href={url('/')} aria-current={path === '/' ? 'page' : undefined}>Project Journal</a>
        <nav aria-label="Site">
          <a href={url('/')} aria-current={path === '/' ? 'page' : undefined}>Journals</a>
          <a href={url('/glossary')} aria-current={path.startsWith('/glossary') ? 'page' : undefined}>Glossary</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      import '../scripts/flow-field';
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -3rem;
    background: var(--ink);
    color: var(--ground);
    padding: var(--s-2) var(--s-4);
    z-index: 10;
  }
  .skip:focus { top: var(--s-2); }
  #flow-field { position: fixed; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  body[data-calm] #flow-field { opacity: 0.4; }
  .site-head { position: relative; }
  .site-head__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 4.5rem;
  }
  .wordmark {
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-sign);
    font-weight: 650;
  }
  nav a {
    text-decoration: none;
    padding: var(--s-2) var(--s-3);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
  }
  @media (hover: hover) and (pointer: fine) { nav a:hover { background: color-mix(in srgb, var(--ink) 8%, transparent); } }
  nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--ink); border-radius: 0; }
  @media (max-width: 30rem) {
    .wordmark { font-size: var(--step-0); }
    nav { gap: 0; }
    nav a { padding-inline: var(--s-2); }
    nav :global([data-theme-label]) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  }
</style>
