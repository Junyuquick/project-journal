---
import '../styles/base.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const fullTitle = title === 'Project Journal' ? title : `${title} | Project Journal`;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('pj-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap site-head__row">
        <a class="wordmark" href="/" aria-current={path === '/' ? 'page' : undefined}>Project Journal</a>
        <nav aria-label="Site">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Network</a>
          <a href="/glossary" aria-current={path.startsWith('/glossary') ? 'page' : undefined}>Glossary</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -3rem;
    background: var(--ink);
    color: var(--ground);
    padding: var(--s-2) var(--s-4);
    z-index: 10;
  }
  .skip:focus { top: var(--s-2); }
  .site-head { border-bottom: 1px solid var(--rule); }
  .site-head__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 3.75rem;
  }
  .wordmark {
    font-family: var(--font-sign);
    font-weight: 800;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-family: var(--font-sign);
    font-weight: 650;
  }
  nav a {
    text-decoration: none;
    padding: var(--s-2) var(--s-3);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
  }
  nav a:hover { background: var(--code-ground); }
  nav a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--ink); border-radius: 0; }
  @media (max-width: 30rem) {
    .wordmark { font-size: var(--step-0); }
    nav a { padding-inline: var(--s-2); }
  }
</style>
