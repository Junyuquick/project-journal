---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<section class="check" aria-labelledby="check-title">
  <h2 id="check-title">Check your understanding</h2>
  <ol>
    {items.map((it) => (
      <li>
        <details>
          <summary>{it.q}</summary>
          <p>{it.a}</p>
        </details>
      </li>
    ))}
  </ol>
</section>

<style>
  .check { margin-top: var(--s-8); padding-top: var(--s-6); border-top: var(--line-width) solid var(--ink); }
  h2 { font-size: var(--step-2); margin-bottom: var(--s-4); }
  ol { margin: 0; padding-left: 1.4rem; display: grid; gap: var(--s-3); }
  li::marker { font-family: var(--font-sign); font-weight: 800; }
  summary { cursor: pointer; font-weight: 700; min-height: 44px; list-style: none; display: flex; gap: var(--s-3); align-items: flex-start; padding-block: var(--s-2); }
  summary::-webkit-details-marker { display: none; }
  /* A station ring that fills in once the answer is revealed */
  summary::before { content: ''; flex: none; width: 1.1rem; height: 1.1rem; margin-top: 0.25em; border-radius: 50%; border: 4px solid var(--ink); background: var(--station-fill); transition: background 0.2s var(--ease-out); }
  details[open] summary::before { background: var(--ink); }
  summary:hover::before { transform: scale(1.1); }
  details[open] summary { margin-bottom: var(--s-2); }
  details p { padding: var(--s-3) var(--s-4); background: var(--code-ground); border-radius: 8px; }
</style>
