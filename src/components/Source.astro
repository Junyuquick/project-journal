---
// A link to the real commit or file in the project's repository.
interface Props { href: string; label: string }
const { href, label } = Astro.props;
---
<a class="source" href={href} target="_blank" rel="noopener"><span class="source__tag">GitHub</span>{label}</a>

<style>
  .source { display: inline-flex; align-items: baseline; gap: var(--s-2); font-family: var(--font-sign); font-weight: 650; overflow-wrap: anywhere; }
  .source__tag { font-size: 0.72em; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; padding: 0.15em 0.5em; border: 1.5px solid currentColor; border-radius: var(--radius-pill); text-decoration: none; display: inline-block; }
</style>
