---
// A system explained as a constellation: stars on a grid, glowing threads routed at 0/45/90 degrees.
import { interchanges, linePoints, toPath, type Station } from '../lib/route';

interface Line { label: string; color: string; stations: string[]; dashed?: boolean }
interface Props { title: string; caption: string; stations: Station[]; lines: Line[] }

const { title, caption, stations, lines } = Astro.props;
const UNIT = 72;
const PAD = 56;
const maxX = Math.max(...stations.map((s) => s.x));
const maxY = Math.max(...stations.map((s) => s.y));
const SIDE = 48; // extra room so names centred on the first or last station are not clipped
const width = maxX * UNIT + PAD * 2 + SIDE * 2;
const height = maxY * UNIT + PAD * 2;
const hubs = interchanges(lines);
const colorOf = (id: string) => lines.find((l) => l.stations.includes(id))?.color ?? 'var(--ink)';
const px = (v: number) => v * UNIT + PAD;
const anchor = { n: 'middle', s: 'middle', e: 'start', w: 'end' } as const;
const offset = { n: [0, -20], s: [0, 30], e: [18, 6], w: [-18, 6] } as const;
---
<figure class="route" style={`--route-w:${width}`}>
  <div class="route__scroll">
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title}>
      <g transform={`translate(${SIDE} 0)`}>
      {lines.map((l) => (
        <path
          class:list={['route__line', { 'route__line--dashed': l.dashed }]}
          d={toPath(linePoints(l.stations, stations), UNIT, PAD)}
          stroke={l.color}
          style={`color:${l.color}`}
          pathLength={l.dashed ? undefined : 1}
        />
      ))}
      {stations.map((s) => {
        const at = s.labelAt ?? 's';
        return (
          <g class="route__station">
            {hubs.has(s.id) ? (
              <rect class="route__hub" x={px(s.x) - 12} y={px(s.y) - 12} width="24" height="24" rx="12" />
            ) : (
              <circle class="route__dot" cx={px(s.x)} cy={px(s.y)} r="8" stroke={colorOf(s.id)} />
            )}
            <text x={px(s.x) + offset[at][0]} y={px(s.y) + offset[at][1]} text-anchor={anchor[at]}>{s.label}</text>
          </g>
        );
      })}
      </g>
    </svg>
  </div>
  <figcaption>
    <span class="route__title">{title}.</span> {caption}
    <ul class="route__legend">
      {lines.map((l) => (
        <li><span class="route__swatch" style={`background:${l.color};color:${l.color}`}></span>{l.label}</li>
      ))}
    </ul>
  </figcaption>
  <ol class="visually-hidden">
    {stations.map((s) => <li>{s.label}{s.note ? `: ${s.note}` : ''}</li>)}
  </ol>
</figure>

<style>
  .route { margin: var(--s-7) 0; }
  .route__scroll { overflow-x: auto; padding-bottom: var(--s-2); }
  svg { display: block; width: 100%; max-width: calc(var(--route-w) * 1px); min-width: min(calc(var(--route-w) * 0.62px), 100%); height: auto; }
  @media (max-width: 40rem) { svg { min-width: calc(var(--route-w) * 0.8px); } }
  .route__line { fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; filter: drop-shadow(0 0 5px currentColor); }
  .route__line--dashed { stroke-dasharray: 2 9; stroke-linecap: round; }
  .route__dot { fill: var(--station-fill); stroke-width: 3; }
  .route__hub { fill: var(--station-fill); stroke: var(--flow-accent); stroke-width: 3; filter: drop-shadow(0 0 8px rgb(var(--sky-glow) / 0.7)); }
  text { font-family: var(--font-sign); font-weight: 600; font-size: 17px; fill: var(--ink); paint-order: stroke; stroke: var(--ground); stroke-width: 5px; stroke-linejoin: round; }
  figcaption { margin-top: var(--s-4); color: var(--ink-soft); font-size: var(--step--1); max-width: var(--measure); }
  .route__title { font-family: var(--font-sign); font-weight: 700; color: var(--ink); }
  .route__legend { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); list-style: none; padding: 0; margin: var(--s-3) 0 0; }
  .route__legend li { display: inline-flex; align-items: center; gap: var(--s-2); }
  .route__swatch { width: 1.6rem; height: 3px; border-radius: 3px; box-shadow: 0 0 8px currentColor; }
  @media (prefers-reduced-motion: no-preference) {
    .route__line:not(.route__line--dashed) { stroke-dasharray: 1; animation: draw 1.1s var(--ease-out) both; }
    @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  }
</style>
