---
import { stationCode } from '../lib/content';
interface Props { slug: string; code: string; color: string; ink: 'dark' | 'light'; next?: { station: number; title: string; slug: string } }
const { slug, code, color, ink, next } = Astro.props;
---
<a class="next" href={next ? `/projects/${slug}/${next.slug}` : `/projects/${slug}`} style={`--line:${color}`}>
  <span class="next__say">{next ? 'Next station' : 'End of the line'}</span>
  <span class="next__where">
    {next && <span class="next__code" style={`background:${color};color:${ink === 'dark' ? '#16181b' : '#fff'}`}>{stationCode(code, next.station)}</span>}
    <span>{next ? next.title : 'Back to the line map'}</span>
  </span>
</a>

<style>
  .next {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-7);
    padding: var(--s-5) 0;
    border-top: var(--line-width) solid var(--line);
    text-decoration: none;
  }
  .next__say { font-family: var(--font-sign); font-weight: 700; color: var(--ink-soft); }
  .next__where { display: flex; align-items: center; gap: var(--s-3); font-family: var(--font-sign); font-weight: 800; font-size: var(--step-2); line-height: 1.2; }
  .next__code { font-size: var(--step-0); padding: 0.3em 0.6em 0.2em; border-radius: var(--radius-pill); }
  .next:hover .next__where span:last-child { text-decoration: underline; text-decoration-thickness: 3px; text-underline-offset: 0.2em; }
</style>
